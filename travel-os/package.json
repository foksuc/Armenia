{
  "name": "travel-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "types:generate": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "build:preview": "TRAVEL_PREVIEW=1 node scripts/build.mjs",
    "validate": "node --import tsx scripts/trips.ts validate",
    "import:trip": "node --import tsx scripts/trips.ts import",
    "approve:trip": "node --import tsx scripts/trips.ts approve",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "latest",
    "@phosphor-icons/react": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gsap": "^3.12.5",
    "maplibre-gl": "^5.0.0",
    "motion": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@types/geojson": "latest",
    "@types/node": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "json-schema-to-typescript": "latest",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
